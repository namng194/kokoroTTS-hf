# Copy to .env (never commit .env). Tokens live ONLY here / in CI secrets.
# The tokens pasted into chat are considered compromised — rotate them first:
#   GitHub: https://github.com/settings/tokens
#   Hugging Face: https://huggingface.co/settings/tokens

# GitHub personal access token (classic or fine-grained with repo + workflow).
GH_TOKEN=
# Hugging Face token with Spaces write scope (for scripts/deploy_hf_space.py).
HF_TOKEN=
# Optional: default Space id, e.g. YOURUSER/kokorotts-hf
HF_SPACE_ID=
